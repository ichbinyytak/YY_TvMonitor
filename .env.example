# ==============================================================================
# YY_TvMonitor Local Environment Configuration Template
# Copy this file to .env and adjust variables to match your environment.
# .env is ignored by Git and will NEVER be committed to GitHub.
# ==============================================================================

# Remote or local build machine SSH host (configured with Android SDK 28/30 javac, d8, aapt)
BUILD_HOST=build_server

# Target Android TV / TV Box IP address and ADB port
TV_DEVICE=192.168.1.100:5555
